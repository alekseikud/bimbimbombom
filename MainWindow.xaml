<Window
    x:Class="AutomatonEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Automaton Editor"
    Width="800"
    Height="600">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <Button Content="Add State" Width="100" Click="AddState_Click"></Button>
        </StackPanel>
        <Canvas x:Name="MainCanvas" Background="White" MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"></Canvas>
    </DockPanel>
</Window>